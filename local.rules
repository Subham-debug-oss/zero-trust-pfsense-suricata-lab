# Custom Suricata rules for the zero-trust segmentation lab
# Paste into Services > Suricata > Interface > Rules > Custom (or local.rules)
# SIDs 9000000+ are reserved for local use.
# Use "drop" for inline IPS mode; change to "alert" if testing in IDS mode.
# Adjust $HOME_NET / $EXTERNAL_NET to your pfSense variable definitions.

# --- SSH brute force: 5+ new SSH connections from one source in 60s ---
drop tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"LOCAL SSH brute force attempt"; flow:to_server; flags:S; threshold:type both, track by_src, count 5, seconds 60; classtype:attempted-admin; sid:9000001; rev:1;)

# --- Internal SSH brute force (lateral movement between VLANs) ---
alert tcp $HOME_NET any -> $HOME_NET 22 (msg:"LOCAL Internal SSH repeated connections (lateral movement?)"; flow:to_server; flags:S; threshold:type both, track by_src, count 8, seconds 60; classtype:attempted-admin; sid:9000002; rev:1;)

# --- SYN flood against a protected host ---
drop tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"LOCAL Possible SYN flood"; flags:S; threshold:type both, track by_dst, count 200, seconds 5; classtype:attempted-dos; sid:9000010; rev:1;)

# --- ICMP flood ---
drop icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"LOCAL ICMP flood"; itype:8; threshold:type both, track by_src, count 100, seconds 5; classtype:attempted-dos; sid:9000011; rev:1;)

# --- UDP flood ---
drop udp $EXTERNAL_NET any -> $HOME_NET any (msg:"LOCAL UDP flood"; threshold:type both, track by_dst, count 300, seconds 5; classtype:attempted-dos; sid:9000012; rev:1;)

# --- Port scan detection (many distinct SYNs from one source) ---
alert tcp any any -> $HOME_NET any (msg:"LOCAL TCP port scan"; flags:S; threshold:type both, track by_src, count 30, seconds 10; classtype:network-scan; sid:9000020; rev:1;)

# --- Simple web attack patterns against DMZ web server ---
drop http $EXTERNAL_NET any -> $HOME_NET any (msg:"LOCAL SQLi UNION SELECT in URI"; flow:to_server,established; http.uri; content:"union"; nocase; content:"select"; nocase; distance:0; classtype:web-application-attack; sid:9000030; rev:1;)

drop http $EXTERNAL_NET any -> $HOME_NET any (msg:"LOCAL Path traversal in URI"; flow:to_server,established; http.uri; content:"../"; classtype:web-application-attack; sid:9000031; rev:1;)

# --- IOT VLAN trying to reach private ranges (policy violation) ---
alert ip 10.0.30.0/24 any -> [10.0.10.0/24,10.0.20.0/24,10.0.99.0/24] any (msg:"LOCAL IOT VLAN attempting to reach internal VLAN"; classtype:policy-violation; sid:9000040; rev:1;)

# --- Management plane probing from non-MGMT networks ---
alert tcp ![10.0.99.0/24,10.99.0.0/24] any -> $HOME_NET [443,8443] (msg:"LOCAL pfSense WebGUI probe from non-management network"; flow:to_server; flags:S; threshold:type limit, track by_src, count 1, seconds 300; classtype:attempted-recon; sid:9000041; rev:1;)
